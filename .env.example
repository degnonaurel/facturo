# Copiez ce fichier en .env et renseignez UNE clé (Anthropic OU OpenAI).
# Ne committez jamais votre .env réel.

# Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# OU OpenAI — https://platform.openai.com
# OPENAI_API_KEY=

# Modèles (optionnel — des défauts raisonnables sont utilisés sinon)
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# OPENAI_MODEL=gpt-4o-mini

# Port du serveur web (défaut 7860)
PORT=7860
